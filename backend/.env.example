DATABASE_URL=postgresql://phishing_user:phishing_pass@127.0.0.1:5433/phishing_db
MODEL_DIR=./ml_model

# ระดับความเสี่ยง (UC-06): >= MIN_RISK_THRESHOLD = แดง, >= SUSPICIOUS_THRESHOLD = เหลือง, ต่ำกว่า = เขียว
MIN_RISK_THRESHOLD=0.5
SUSPICIOUS_THRESHOLD=0.3

# กุญแจเข้ารหัสเนื้อหาอีเมล (Fernet) — สร้างด้วย:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ===== ความเป็นส่วนตัวของข้อมูล =====
# ค่าด้านล่างตั้งไว้แบบปลอดภัยที่สุดก่อน การเปิดแต่ละตัวคือการเลือกเก็บข้อมูลส่วนบุคคลเพิ่ม

# เก็บเนื้อหาอีเมล (เข้ารหัสแล้ว) ลงฐานข้อมูลหรือไม่
STORE_EMAIL_CONTENT=false

# เก็บคำที่ตัดได้ / TF-IDF / เวกเตอร์คุณลักษณะ "รายอีเมล" หรือไม่
#
# คำเตือน: คอลัมน์ word และ feature_name เก็บคำของอีเมลเป็นข้อความธรรมดาผูกกับ email_id
# ใครอ่านฐานข้อมูลได้ก็ประกอบเนื้อหาอีเมลกลับได้ แม้ body_encrypted จะเข้ารหัสไว้
# เปิดเฉพาะตอนเก็บข้อมูลทำวิจัย และต้องแจ้งผู้ใช้ให้ทราบ — ห้ามเปิดบนระบบที่ให้บริการจริง
STORE_NLP_ARTIFACTS=false

# ลบข้อมูลที่เก่ากว่ากี่วัน (0 = ไม่ลบอัตโนมัติ)
# ระบบลบให้หนึ่งครั้งตอนเริ่มทำงาน ใช้งานจริงให้ตั้ง cron เรียก POST /api/v1/data/purge เป็นรอบ ๆ
DATA_RETENTION_DAYS=90

# กุญแจสำหรับ HMAC ของ body_hash กันไม่ให้ผู้อื่นนำอีเมลที่มีอยู่มาแฮชเทียบว่าเคยผ่านระบบหรือไม่
# ว่างไว้จะใช้ ENCRYPTION_KEY แทน — สร้างค่าสุ่มด้วย:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HASH_PEPPER=

# จำกัดคำขอต่อ IP ต่อนาทีสำหรับ POST /api/v1/analyze (0 = ไม่จำกัด)
# ตัวนับอยู่ในหน่วยความจำของโปรเซสเดียว ถ้ารันหลาย worker ให้ไปจำกัดที่ reverse proxy แทน
ANALYZE_RATE_LIMIT_PER_MINUTE=60

# ===== ตั้งเมื่อมีตัวคั่นเท่านั้น (reverse proxy / Cloudflare Tunnel) =====
# ว่างไว้ = ไม่เชื่อ header ใดเลย ซึ่งถูกต้องแล้วเมื่อเปิดระบบตรงจากเครื่อง
#
# ถ้ามีตัวคั่น ต้องตั้งค่านี้ ไม่งั้น rate limit จะเห็นผู้ใช้ทุกคนเป็น IP เดียวกัน
# แล้วคนเดียวยิงจนเต็มเพดานทำให้คนอื่นใช้ไม่ได้ทั้งหมด (หน้า login จะโดนหนักสุด)
#
# ใส่ IP หรือ CIDR ของตัวคั่นเท่านั้น คั่นด้วย comma เช่น
#   cloudflared รันบนเครื่องเดียวกัน -> 127.0.0.1
#   cloudflared อยู่ในคอนเทนเนอร์     -> 172.16.0.0/12
# **ห้ามใส่ 0.0.0.0/0** เพราะจะกลายเป็นเชื่อ header จากใครก็ได้
# ผู้โจมตีจะใส่ IP สุ่มทุกคำขอแล้วข้าม rate limit ไปทั้งหมด
TRUSTED_PROXIES=
# Cloudflare ส่ง CF-Connecting-IP / nginx กับ traefik มักส่ง X-Forwarded-For
REAL_IP_HEADER=CF-Connecting-IP

# ===== เข้าสู่ระบบด้วยบัญชี Google (ไม่บังคับ) =====
# ว่าง = ปิดช่องทางนี้ หน้าเว็บจะไม่แสดงปุ่มและไม่ติดต่อ Google เลย
#
# เอามาจาก Google Cloud Console > APIs & Services > Credentials
#   สร้าง OAuth client ID ชนิด "Web application"
#   Authorized JavaScript origins ต้องใส่ที่อยู่ที่เปิดหน้าเว็บจริง เช่น
#     http://127.0.0.1:8000        (ตอนพัฒนา Google ยอมให้ใช้ http เฉพาะ loopback)
#     https://your-tunnel.example  (ตอนเปิดผ่าน Cloudflare Tunnel)
#   ไม่ต้องใส่ Authorized redirect URIs เพราะใช้วิธีตรวจ ID token ไม่ใช่ code flow
#
# ค่านี้ไม่ใช่ความลับ ถูกฝังในหน้าเว็บอยู่แล้วตามการออกแบบของ Google
# และระบบไม่ต้องใช้ client secret เลย
#
# ต้องให้เซิร์ฟเวอร์ออกเน็ตได้ เพื่อดึง public key ของ Google มาตรวจลายเซ็น
GOOGLE_CLIENT_ID=

LOG_FILE=./logs/backend.log
LOG_LEVEL=INFO

# token สำหรับ POST /api/v1/model/reload และ GET /api/v1/stats (ว่าง = ปิด endpoint)
ADMIN_TOKEN=

CORS_ORIGINS=chrome-extension://*,https://mail.google.com
